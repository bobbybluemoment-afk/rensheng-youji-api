{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "人生有迹报告正文语义补丁",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "paragraphs", "summary", "stage_story", "yearly_outlook", "action_guide", "open_questions"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "brief_id": {"type": "string", "minLength": 1},
    "paragraphs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["slot_id", "text"], "properties": {"slot_id": {"type": "string", "minLength": 3}, "text": {"type": "string", "minLength": 20}}}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["capabilities_resources"],
      "properties": {
        "capabilities_resources": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "minLength": 16}}
      }
    },
    "stage_story": {
      "type": "object", "additionalProperties": false,
      "required": ["previous_foundation", "recent_development", "present_task", "next_direction", "long_range"],
      "properties": {
        "previous_foundation": {"type": "string", "minLength": 20}, "recent_development": {"type": "string", "minLength": 20},
        "present_task": {"type": "string", "minLength": 20}, "next_direction": {"type": "string", "minLength": 20},
        "long_range": {"type": "string", "minLength": 20}
      }
    },
    "yearly_outlook": {
      "type": "object", "additionalProperties": false, "required": ["start_year", "end_year", "summary", "stages", "key_years"],
      "properties": {
        "start_year": {"type": "integer"}, "end_year": {"type": "integer"}, "summary": {"type": "string", "minLength": 40},
        "stages": {"type": "array", "minItems": 3, "maxItems": 6, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["start_year", "end_year", "title", "narrative", "real_world_signals", "key_years"],
          "properties": {
            "start_year": {"type": "integer"}, "end_year": {"type": "integer"},
            "title": {"type": "string", "minLength": 4, "maxLength": 18},
            "narrative": {"type": "string", "minLength": 45, "maxLength": 140},
            "real_world_signals": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "minLength": 4, "maxLength": 24}},
            "key_years": {"type": "array", "items": {"type": "integer"}}
          }
        }},
        "key_years": {"type": "array", "minItems": 3, "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["year", "title", "what_changes", "what_to_notice", "confidence"],
          "properties": {
            "year": {"type": "integer"}, "title": {"type": "string", "minLength": 4, "maxLength": 18},
            "what_changes": {"type": "string", "minLength": 24, "maxLength": 80},
            "what_to_notice": {"type": "string", "minLength": 16, "maxLength": 50},
            "confidence": {"enum": ["高置信", "中等置信", "待验证"]}
          }
        }}
      }
    },
    "action_guide": {
      "type": "object", "additionalProperties": false, "required": ["priority_actions", "reduce", "traditional_preferences"],
      "properties": {
        "priority_actions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 16}},
        "reduce": {"type": "string", "minLength": 16},
        "traditional_preferences": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["area", "advice"], "properties": {"area": {"type": "string", "minLength": 2}, "advice": {"type": "string", "minLength": 16}}}}
      }
    },
    "open_questions": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "minLength": 8}}
  }
}
