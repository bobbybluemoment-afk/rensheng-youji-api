{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rensheng-youji.local/schemas/analysis-input.schema.json",
  "title": "人生有迹内置命理分析输入",
  "description": "由确定性排盘层交给命理分析核心的完整输入。排盘事实不得由语言模型补算。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request",
    "person",
    "chart",
    "solar_terms_and_boundaries",
    "five_elements",
    "luck_cycles",
    "annual_cycles",
    "reality_context",
    "calibration"
  ],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "analysis_as_of", "locale", "calendar_basis", "target_range"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "analysis_as_of": {"type": "string", "format": "date"},
        "locale": {"type": "string", "default": "zh-CN"},
        "calendar_basis": {
          "type": "string",
          "enum": ["local_civil", "beijing_time", "true_solar_time", "custom"]
        },
        "target_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_year", "end_year"],
          "properties": {
            "start_year": {"type": "integer", "minimum": 1800, "maximum": 2300},
            "end_year": {"type": "integer", "minimum": 1800, "maximum": 2300}
          }
        },
        "include_monthly": {"type": "boolean", "default": false},
        "source": {"type": ["string", "null"]}
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "gender", "birth"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "gender": {
          "type": "string",
          "enum": ["male", "female", "nonbinary", "unspecified"]
        },
        "gender_label": {"type": ["string", "null"]},
        "birth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local_datetime",
            "place_name",
            "country_or_region",
            "timezone",
            "longitude",
            "time_source",
            "time_precision"
          ],
          "properties": {
            "local_datetime": {"type": "string", "format": "date-time"},
            "place_name": {"type": "string", "minLength": 1},
            "country_or_region": {"type": "string", "minLength": 1},
            "timezone": {"type": "string", "minLength": 1},
            "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
            "longitude": {"type": "number", "minimum": -180, "maximum": 180},
            "time_source": {
              "type": "string",
              "enum": ["birth_certificate", "family_record", "memory", "estimated", "unknown"]
            },
            "time_precision": {
              "type": "string",
              "enum": ["minute", "quarter_hour", "half_hour", "hour", "two_hour_branch", "unknown"]
            },
            "raw_input": {"type": ["string", "null"]}
          }
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day_master", "pillars"],
      "properties": {
        "day_master": {"$ref": "#/$defs/heavenlyStem"},
        "pillars": {
          "type": "object",
          "additionalProperties": false,
          "required": ["year", "month", "day", "hour"],
          "properties": {
            "year": {"$ref": "#/$defs/pillar"},
            "month": {"$ref": "#/$defs/pillar"},
            "day": {"$ref": "#/$defs/pillar"},
            "hour": {"$ref": "#/$defs/pillar"}
          }
        },
        "nayin": {
          "type": ["object", "null"],
          "additionalProperties": {"type": "string"}
        },
        "calculation_engine": {"type": "string", "minLength": 1},
        "calculation_version": {"type": ["string", "null"]}
      }
    },
    "solar_terms_and_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone_resolved",
        "daylight_saving_applied",
        "true_solar_time_applied",
        "nearest_solar_terms",
        "boundary_flags"
      ],
      "properties": {
        "timezone_resolved": {"type": "string", "minLength": 1},
        "utc_offset": {"type": ["string", "null"]},
        "daylight_saving_applied": {"type": "boolean"},
        "true_solar_time_applied": {"type": "boolean"},
        "true_solar_datetime": {"type": ["string", "null"], "format": "date-time"},
        "nearest_solar_terms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "datetime", "relation"],
            "properties": {
              "name": {"type": "string"},
              "datetime": {"type": "string", "format": "date-time"},
              "relation": {"type": "string", "enum": ["previous", "next", "boundary"]}
            }
          }
        },
        "boundary_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "solar_term_boundary",
              "day_boundary",
              "hour_branch_boundary",
              "timezone_uncertain",
              "daylight_saving_uncertain",
              "true_solar_time_sensitive",
              "luck_start_boundary",
              "none"
            ]
          },
          "uniqueItems": true
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "five_elements": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "method_version", "scores", "normalized_percentages"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "method_version": {"type": "string", "minLength": 1},
            "scores": {"$ref": "#/$defs/fiveElementNumbers"},
            "normalized_percentages": {"$ref": "#/$defs/fiveElementPercentages"},
            "assumptions": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "luck_cycles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "start_age", "start_datetime", "method", "cycles"],
      "properties": {
        "direction": {"type": "string", "enum": ["forward", "backward"]},
        "start_age": {"type": "number", "minimum": 0, "maximum": 20},
        "start_datetime": {"type": "string", "format": "date-time"},
        "method": {"type": "string", "minLength": 1},
        "cycles": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/luckCycle"}
        }
      }
    },
    "annual_cycles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/annualCycle"}
    },
    "monthly_cycles": {
      "type": ["array", "null"],
      "items": {"$ref": "#/$defs/monthlyCycle"}
    },
    "reality_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "questions"],
      "properties": {
        "facts": {
          "type": "array",
          "items": {"$ref": "#/$defs/realityFact"}
        },
        "questions": {"type": "array", "items": {"type": "string"}},
        "current_location": {"type": ["string", "null"]},
        "occupation": {"type": ["string", "null"]},
        "industry": {"type": ["string", "null"]},
        "current_role": {"type": ["string", "null"]},
        "education": {"type": ["string", "null"]},
        "relationship_status": {"type": ["string", "null"]},
        "relationship_history": {"type": ["string", "null"]},
        "family_stage": {"type": ["string", "null"]},
        "family_background": {"type": ["string", "null"]},
        "caregiving_responsibilities": {"type": ["string", "null"]},
        "financial_stage": {"type": ["string", "null"]},
        "living_arrangement": {"type": ["string", "null"]},
        "resource_context": {"type": ["string", "null"]},
        "partner_facts": {"type": ["string", "null"]},
        "current_concerns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_feedback", "confirmed_events", "rejected_claims"],
      "properties": {
        "candidate_feedback": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidateFeedback"}
        },
        "confirmed_events": {
          "type": "array",
          "items": {"$ref": "#/$defs/realityFact"}
        },
        "rejected_claims": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "heavenlyStem": {
      "type": "string",
      "enum": ["甲", "乙", "丙", "丁", "戊", "己", "庚", "辛", "壬", "癸"]
    },
    "earthlyBranch": {
      "type": "string",
      "enum": ["子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥"]
    },
    "tenGod": {
      "type": "string",
      "enum": ["比肩", "劫财", "食神", "伤官", "偏财", "正财", "七杀", "正官", "偏印", "正印"]
    },
    "hiddenStem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stem", "qi_level", "ten_god"],
      "properties": {
        "stem": {"$ref": "#/$defs/heavenlyStem"},
        "qi_level": {"type": "string", "enum": ["main", "middle", "residual"]},
        "ten_god": {"$ref": "#/$defs/tenGod"},
        "weight": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stem", "branch", "stem_ten_god", "hidden_stems"],
      "properties": {
        "stem": {"$ref": "#/$defs/heavenlyStem"},
        "branch": {"$ref": "#/$defs/earthlyBranch"},
        "stem_ten_god": {
          "oneOf": [
            {"$ref": "#/$defs/tenGod"},
            {"type": "string", "const": "日主"}
          ]
        },
        "hidden_stems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/hiddenStem"}
        }
      }
    },
    "fiveElementNumbers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wood", "fire", "earth", "metal", "water"],
      "properties": {
        "wood": {"type": "number", "minimum": 0},
        "fire": {"type": "number", "minimum": 0},
        "earth": {"type": "number", "minimum": 0},
        "metal": {"type": "number", "minimum": 0},
        "water": {"type": "number", "minimum": 0}
      }
    },
    "fiveElementPercentages": {
      "allOf": [
        {"$ref": "#/$defs/fiveElementNumbers"},
        {
          "properties": {
            "wood": {"maximum": 100},
            "fire": {"maximum": 100},
            "earth": {"maximum": 100},
            "metal": {"maximum": 100},
            "water": {"maximum": 100}
          }
        }
      ]
    },
    "luckCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "stem", "branch", "stem_ten_god", "hidden_stems", "start_datetime", "end_datetime", "start_age", "end_age"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "stem": {"$ref": "#/$defs/heavenlyStem"},
        "branch": {"$ref": "#/$defs/earthlyBranch"},
        "stem_ten_god": {"$ref": "#/$defs/tenGod"},
        "hidden_stems": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/hiddenStem"}},
        "start_datetime": {"type": "string", "format": "date-time"},
        "end_datetime": {"type": "string", "format": "date-time"},
        "start_age": {"type": "number", "minimum": 0},
        "end_age": {"type": "number", "minimum": 0}
      }
    },
    "annualCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "age", "stem", "branch", "stem_ten_god", "hidden_stems", "luck_cycle_index"],
      "properties": {
        "year": {"type": "integer", "minimum": 1800, "maximum": 2300},
        "age": {"type": "number", "minimum": 0},
        "stem": {"$ref": "#/$defs/heavenlyStem"},
        "branch": {"$ref": "#/$defs/earthlyBranch"},
        "stem_ten_god": {"$ref": "#/$defs/tenGod"},
        "hidden_stems": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/hiddenStem"}},
        "luck_cycle_index": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "monthlyCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "month", "stem", "branch", "stem_ten_god", "hidden_stems"],
      "properties": {
        "year": {"type": "integer", "minimum": 1800, "maximum": 2300},
        "month": {"type": "integer", "minimum": 1, "maximum": 12},
        "stem": {"$ref": "#/$defs/heavenlyStem"},
        "branch": {"$ref": "#/$defs/earthlyBranch"},
        "stem_ten_god": {"$ref": "#/$defs/tenGod"},
        "hidden_stems": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/hiddenStem"}}
      }
    },
    "realityFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "statement", "source"],
      "properties": {
        "domain": {"type": "string"},
        "statement": {"type": "string", "minLength": 1},
        "source": {"type": "string", "enum": ["user", "document", "system", "other"]},
        "date_or_range": {"type": ["string", "null"]}
      }
    },
    "candidateFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "status"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["match", "partial", "reject", "uncertain"]},
        "comment": {"type": ["string", "null"]}
      }
    }
  }
}
