      "additionalProperties": false,
      "required": [
        "analysis_id",
        "request_id",
        "core_version",
        "generated_at",
        "analysis_as_of",
        "target_range",
        "input_completeness",
        "status"
      ],
      "properties": {
        "analysis_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "core_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "analysis_as_of": {
          "type": "string",
          "format": "date"
        },
        "target_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_year",
            "end_year"
          ],
          "properties": {
            "start_year": {
              "type": "integer"
            },
            "end_year": {
              "type": "integer"
            }
          }
        },
        "input_completeness": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "blocked"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "cannot_analyze"
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "chart_facts": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "day_master",
        "pillars",
        "luck_cycles",
        "annual_cycles"
      ],
      "properties": {
        "day_master": {
          "type": "string",
          "minLength": 1
        },
        "pillars": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "year",
            "month",
            "day",
            "hour"
          ],
          "properties": {
            "year": {
              "$ref": "#/$defs/factPillar"
            },
            "month": {
              "$ref": "#/$defs/factPillar"
            },
            "day": {
              "$ref": "#/$defs/factPillar"
            },
            "hour": {
