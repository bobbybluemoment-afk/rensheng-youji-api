        "luck_cycles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "annual_cycles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "chart_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks",
        "boundary_dependencies",
        "versions"
