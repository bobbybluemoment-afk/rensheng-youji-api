{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rensheng-youji.local/schemas/semantic-repair-patch.schema.json",
  "title": "人生有迹语义局部返修补丁",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "source_sha256", "repair_request_sha256", "replacements"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage": {"enum": ["independent_method", "core_synthesis"]},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repair_request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "replacements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "value"],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "value": {}
        }
      }
    }
  }
}
