{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "校准自由回答语义补丁",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "responses"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_number", "user_text", "facts", "candidate_updates"],
        "properties": {
          "question_number": {"type": "integer", "minimum": 1, "maximum": 5},
          "user_text": {"type": "string", "minLength": 1},
          "facts": {"type": "array", "items": {"type": "string", "minLength": 4}},
          "candidate_updates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_id", "status", "reason"],
              "properties": {
                "candidate_id": {"type": "string"},
                "status": {"enum": ["match", "partial", "reject", "uncertain"]},
                "reason": {"type": "string", "minLength": 6}
              }
            }
          }
        }
      }
    }
  }
}
