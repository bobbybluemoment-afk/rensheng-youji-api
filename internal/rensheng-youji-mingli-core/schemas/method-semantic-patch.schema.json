{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rensheng-youji.local/schemas/method-semantic-patch.schema.json",
  "title": "人生有迹独立方法语义答卷",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result", "technical_conclusions", "reality_hypotheses", "domain_limits", "limitations", "failure_reasons", "degradation_effects"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "result": {"enum": ["complete", "insufficient_evidence", "blocked_input", "generation_failed"]},
    "technical_conclusions": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/technicalConclusion"}},
    "reality_hypotheses": {"type": "array", "maxItems": 18, "items": {"$ref": "#/$defs/realityHypothesis"}},
    "domain_limits": {"type": "array", "items": {"$ref": "#/$defs/domainLimit"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 4}},
    "failure_reasons": {"type": "array", "items": {"type": "string", "minLength": 4}},
    "degradation_effects": {"type": "array", "items": {"type": "string", "minLength": 4}}
  },
  "$defs": {
    "confidence": {"enum": ["high", "medium", "to_verify"]},
    "domain": {"enum": ["self_growth", "love_partner", "career", "finance_resources", "body_emotion", "family_growth"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_layer", "chart_refs", "observation", "interpretation", "limitations", "confidence"],
      "properties": {
        "source_layer": {"enum": ["natal", "root_seed_flower_fruit", "resource_relationship", "blind_shared", "blind_duan", "blind_yang", "luck_cycle", "annual"]},
        "chart_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "observation": {"type": "string", "minLength": 4},
        "interpretation": {"type": "string", "minLength": 6},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 4}},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "technicalConclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "mechanism_chain", "chart_refs", "evidence", "conditions", "counterconditions", "time_scope", "confidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 8},
        "mechanism_chain": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 2}},
        "chart_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "counterconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "time_scope": {"type": "string", "minLength": 2},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "realityHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_from_conclusion_numbers", "domain", "normalized_direction", "statement", "observable_indicators", "conditions", "counterevidence", "unsupported_extensions", "time_scope"],
      "properties": {
        "derived_from_conclusion_numbers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "domain": {"$ref": "#/$defs/domain"},
        "normalized_direction": {"type": "string", "minLength": 4},
        "statement": {"type": "string", "minLength": 12},
        "observable_indicators": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "counterevidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "unsupported_extensions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "time_scope": {"type": "string", "minLength": 2}
      }
    },
    "domainLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "status", "reasoning"],
      "properties": {
        "domain": {"$ref": "#/$defs/domain"},
        "status": {"enum": ["insufficient_evidence", "not_applicable"]},
        "reasoning": {"type": "string", "minLength": 8}
      }
    }
  }
}
