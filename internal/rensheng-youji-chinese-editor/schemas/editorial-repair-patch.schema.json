{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "局部中文修订补丁",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_id", "repairs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "draft_id": {"type": "string"},
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "text"],
        "properties": {"slot_id": {"type": "string"}, "text": {"type": "string", "minLength": 20}}
      }
    }
  }
}
