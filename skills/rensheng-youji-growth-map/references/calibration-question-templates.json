      "candidate_domains": ["career", "learning"],
      "comparison_axis": "目标不清时的第一处理动作",
      "time_window": "长期重复出现的工作或学习情境",
      "selection_rule": "只选最先采取、且最常决定后续行动的一项",
      "answer_type": "first_response",
      "evidence_mode": "stable_pattern",
