        {"key": "A", "value_code": "research_plan", "text": "先查资料、列条件和步骤，想清楚后再开始"},
        {"key": "B", "value_code": "prototype_feedback", "text": "先做出一个小版本，再根据真实反馈继续修改"},
        {"key": "C", "value_code": "people_alignment", "text": "先找关键的人确认要求，方向一致后再推进"}
      ],
      "calibration_targets": ["complete_self_portrait.cognition_and_decision", "complete_self_portrait.action_and_execution"]
    },
    {
